# PostgreSQL
DATABASE_URL=postgres://aso:aso@localhost:5433/aso

# API
PORT=3000

# Скрейпинг
DEFAULT_COUNTRY=us
# Пауза на слот канала. Эффективный rate ≈ channels / SCRAPE_DELAY_MS.
# Бюджет анализа на клиенте — 90с. Чтобы успеть, нужно rate ≥ MAX_KEYWORDS/70.
# 900мс×6 каналов = ~6.7 req/s → 200 ключей ≈ 30с. Ниже — быстрее, но выше риск 429.
SCRAPE_DELAY_MS=900
SCRAPE_MAX_RETRIES=3
# Параллелизм запросов. APPLE_CHANNELS — нативный поиск (ранки),
# HTTP_CHANNELS — lookup/suggest. Каждый канал = отдельный device-GUID.
# На одном IP больше ~8 каналов повышает риск бана — реальное масштабирование
# даёт прокси-пул (см. TODO антибан).
APPLE_CHANNELS=6
HTTP_CHANNELS=6
# Объём подбора ключей (скорость vs охват). 300 при rate ~2.7/s не укладывается
# в 90с — снижено до 200 (хвост за ~200 почти не добавляет релевантных ключей).
MAX_KEYWORDS=200
BFS_MAX_DEPTH=2

# Apple Search Ads (заполнить после получения аккаунта)
ASA_CLIENT_ID=
ASA_TEAM_ID=
ASA_KEY_ID=
ASA_PRIVATE_KEY_PATH=

# AI: инсайты (/ext/insights) + LLM-проход релевантности кандидатов.
# Без ключа: инсайты на детерминированном фолбэке, релевантность — на эвристике.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Сколько ключей максимум уходит в LLM (контекст/стоимость).
INSIGHTS_MAX_KEYWORDS=40
