# PostgreSQL
DATABASE_URL=postgres://aso:aso@localhost:5433/aso

# API
PORT=3000

# Скрейпинг
DEFAULT_COUNTRY=us
SCRAPE_DELAY_MS=1500
SCRAPE_MAX_RETRIES=3
# Параллелизм запросов. APPLE_CHANNELS — нативный поиск (ранки),
# HTTP_CHANNELS — lookup/suggest. Эффективный rate ≈ channels / SCRAPE_DELAY_MS.
APPLE_CHANNELS=4
HTTP_CHANNELS=4
# Объём подбора ключей (скорость vs охват).
MAX_KEYWORDS=300
BFS_MAX_DEPTH=2

# Apple Search Ads (заполнить после получения аккаунта)
ASA_CLIENT_ID=
ASA_TEAM_ID=
ASA_KEY_ID=
ASA_PRIVATE_KEY_PATH=
