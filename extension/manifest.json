{
  "manifest_version": 3,
  "name": "RankRadar — ASO keyword analyzer",
  "version": "2.2.0",
  "description": "ASO keyword analytics for any app on Apple App Store or Google Play — in one click from the store page.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RankRadar — analyze this app",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://scrap-production-c0db.up.railway.app/*"
  ]
}
